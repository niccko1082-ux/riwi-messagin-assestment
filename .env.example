# Base de datos (PostgreSQL 15+, ver database/migrations)
DB_HOST=db
DB_PORT=5432
DB_NAME=bd_nombre_apellido_clan
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=changeme
# Rol de aplicación sin BYPASSRLS (creado por 008_create_rls.sql)
DB_APP_USER=rw_app
DB_APP_PASSWORD=changeme
# Rol del worker de embeddings, BYPASSRLS (creado por 010_create_embedding_worker.sql)
DB_WORKER_USER=rw_worker
DB_WORKER_PASSWORD=changeme

# Backend (Spring Boot)
SERVER_PORT=8080
JWT_SECRET=changeme-min-32-caracteres-en-produccion
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Copiloto de IA (NVIDIA NIM, API compatible con OpenAI SDK — ver DECISIONS.md)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verificados contra /v1/models al validar Fase 5 (NVIDIA retira modelos con frecuencia —
# revisar entitlements de la cuenta si alguno responde 404/410).
NVIDIA_CHAT_MODEL=openai/gpt-oss-20b
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
